<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block WordPress scan attempts
  RewriteRule ^wp-admin(/.*)?$ - [F,L]

  # Redirect published Portuguese URLs to the English site structure.
  RewriteRule ^projetos/observatorio\-fiscal/?$ /fiscal-observatory/ [R=301,L]
  RewriteRule ^projetos/observatorio\-fiscal\-estudo/?$ /projects/fiscal-observatory/ [R=301,L]
  RewriteRule ^projetos/observatorio\-fiscal\-estudo/index\.html$ /projects/fiscal-observatory/ [R=301,L]
  RewriteRule ^projetos/emendas\-parlamentares/?$ /projects/parliamentary-amendments/ [R=301,L]
  RewriteRule ^projetos/emendas\-parlamentares/index\.html$ /projects/parliamentary-amendments/ [R=301,L]
  RewriteRule ^textos/a\-economia\-da\-paz/?$ /essays/the-economics-of-peace/ [R=301,L]
  RewriteRule ^textos/a\-economia\-da\-paz/index\.html$ /essays/the-economics-of-peace/ [R=301,L]
  RewriteRule ^textos/a\-farsa\-do\-pleno\-emprego\-ou\-a\-farsa/?$ /essays/the-full-employment-sham/ [R=301,L]
  RewriteRule ^textos/a\-farsa\-do\-pleno\-emprego\-ou\-a\-farsa/index\.html$ /essays/the-full-employment-sham/ [R=301,L]
  RewriteRule ^textos/a\-metastase\-da\-globalizacao/?$ /essays/the-metastasis-of-globalization/ [R=301,L]
  RewriteRule ^textos/a\-metastase\-da\-globalizacao/index\.html$ /essays/the-metastasis-of-globalization/ [R=301,L]
  RewriteRule ^textos/as\-tribos\-politicas\-do\-brasil\-parte/?$ /essays/brazils-political-tribes-part-1/ [R=301,L]
  RewriteRule ^textos/as\-tribos\-politicas\-do\-brasil\-parte/index\.html$ /essays/brazils-political-tribes-part-1/ [R=301,L]
  RewriteRule ^textos/do\-fim\-da\-historia\-e\-da\-decadencia/?$ /essays/on-the-end-of-history-and-the-decay-of-being/ [R=301,L]
  RewriteRule ^textos/do\-fim\-da\-historia\-e\-da\-decadencia/index\.html$ /essays/on-the-end-of-history-and-the-decay-of-being/ [R=301,L]
  RewriteRule ^textos/um\-apelo\-a\-intolerancia/?$ /essays/a-plea-for-intolerance/ [R=301,L]
  RewriteRule ^textos/um\-apelo\-a\-intolerancia/index\.html$ /essays/a-plea-for-intolerance/ [R=301,L]
  RewriteRule ^textos/textos\.css$ /essays/archive.css [R=301,L]
  RewriteRule ^textos/textos\.js$ /essays/archive.js [R=301,L]
  RewriteRule ^textos/imagens/(.+)$ /essays/images/$1 [R=301,L]
  RewriteRule ^projetos/?$ /projects/ [R=301,L]
  RewriteRule ^projetos/index\.html$ /projects/ [R=301,L]
  RewriteRule ^projetos/(.+)$ /projects/$1 [R=301,L]
  RewriteRule ^pesquisa/?$ /research/ [R=301,L]
  RewriteRule ^pesquisa/index\.html$ /research/ [R=301,L]
  RewriteRule ^pesquisa/(.+)$ /research/$1 [R=301,L]
  RewriteRule ^curriculum/?$ /cv/ [R=301,L]
  RewriteRule ^curriculum/index\.html$ /cv/ [R=301,L]
  RewriteRule ^curriculum/(.+)$ /cv/$1 [R=301,L]
  RewriteRule ^textos/?$ /essays/ [R=301,L]
  RewriteRule ^textos/index\.html$ /essays/ [R=301,L]
  RewriteRule ^textos/(.+)$ /essays/$1 [R=301,L]
  RewriteRule ^observatorio-fiscal/?$ /fiscal-observatory/ [R=301,L]
  RewriteRule ^observatorio-fiscal/index\.html$ /fiscal-observatory/ [R=301,L]
  RewriteRule ^observatorio-fiscal/(.+)$ /fiscal-observatory/$1 [R=301,L]
  RewriteRule ^emendas-parlamentares/?$ /parliamentary-amendments/ [R=301,L]
  RewriteRule ^emendas-parlamentares/index\.html$ /parliamentary-amendments/ [R=301,L]
  RewriteRule ^emendas-parlamentares/(.+)$ /parliamentary-amendments/$1 [R=301,L]
  RewriteRule ^foto-quiz/?$ /photo-quiz/ [R=301,L]
  RewriteRule ^foto-quiz/index\.html$ /photo-quiz/ [R=301,L]
  RewriteRule ^foto-quiz/(.+)$ /photo-quiz/$1 [R=301,L]

  # Retired application. Block deep links and files before serving existing paths.
  RewriteRule ^eixo(/|$) - [G,L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Clean URLs: /cv -> /cv/index.html
  RewriteRule ^([a-z0-9-]+)/?$ /$1/index.html [L]

</IfModule>

# UTF-8 everywhere
AddDefaultCharset UTF-8

# Proper MIME types
AddType text/html .html
AddType text/css .css
AddType application/javascript .js

# Security headers
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Disallow embedding in frames (clickjacking protection)
  Header always set X-Frame-Options "DENY"

  # Force HTTPS for 2 years
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Content Security Policy — personal/portfolio site, no external scripts
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; frame-ancestors 'none'"

  # Do not leak full referrer to cross-origin destinations
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

