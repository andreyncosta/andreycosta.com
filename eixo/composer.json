{
    "name": "andreycosta/eixo",
    "description": "Eixo: personal health record with dual AI reading of lab reports",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "anthropic-ai/sdk": "^0.59",
        "guzzlehttp/guzzle": "^7.9",
        "smalot/pdfparser": "^2"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
