# PDFs are generated externally and uploaded manually
public_html/curriculum/download/*.pdf

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Hostinger / cPanel artifacts
.cpanel*
.htpasswd
error_log

# Application state must never be deployed or versioned.
*.sqlite*
*.db
*.db-*
*.csv
*.zip
candidatos-private/
artifacts/

# Eixo: dependencies are installed on the server with composer
eixo/vendor/

# Impeccable: o skill e seu binario por plataforma sao instalados por maquina, nao versionados.
# A fonte fica em .github/skills/impeccable; .claude/skills/impeccable e uma juncao para ela.
.github/skills/impeccable/
.claude/skills/impeccable/
.claude/settings.local.json

# Impeccable: estado efêmero de rodada (servidor de decisão, build-phase, capturas).
eixo/.impeccable/questions/
eixo/.impeccable/build/
eixo/.impeccable/review/
